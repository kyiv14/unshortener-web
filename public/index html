<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unshorten.it Clone — Расшифровка ссылок</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col items-center p-4">

    <div class="w-full max-w-2xl mt-10 md:mt-20">
        <header class="text-center mb-10">
            <h1 class="text-4xl font-bold text-blue-400 mb-2">Unshorten.it</h1>
            <p class="text-slate-400">Узнайте, куда ведет ссылка, прежде чем нажать на неё</p>
        </header>

        <div class="glass p-2 rounded-2xl flex flex-col md:flex-row gap-2 shadow-2xl border border-slate-700">
            <input id="urlInput" type="text" placeholder="Вставьте сокращенную ссылку (bit.ly, t.co...)" 
                   class="flex-1 bg-transparent p-4 outline-none text-lg border-none focus:ring-0">
            <button onclick="unshorten()" id="btn" 
                    class="bg-blue-600 hover:bg-blue-500 text-white px-8 py-4 rounded-xl font-bold transition-all flex items-center justify-center gap-2">
                <span>Проверить</span>
                <i class="fas fa-arrow-right"></i>
            </button>
        </div>

        <div id="loader" class="hidden mt-10 text-center">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-blue-500 border-t-transparent"></div>
            <p class="mt-2 text-blue-400 animate-pulse">Анализируем маршрут...</p>
        </div>

        <div id="result" class="hidden mt-8 space-y-4">
            
            <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700 shadow-xl">
                <div class="flex items-start gap-4 mb-4">
                    <img id="siteIcon" src="" alt="Favicon" class="w-10 h-10 rounded bg-slate-700 p-1">
                    <div>
                        <h2 id="siteTitle" class="text-xl font-bold text-white leading-tight"></h2>
                        <p id="siteDesc" class="text-sm text-slate-400 mt-1 line-clamp-2"></p>
                    </div>
                </div>
                
                <div class="p-3 bg-slate-900 rounded-lg break-all border border-slate-700">
                    <p class="text-xs text-slate-500 mb-1 font-mono">ФИНАЛЬНЫЙ URL:</p>
                    <a id="finalUrl" href="#" target="_blank" class="text-blue-400 hover:underline font-medium"></a>
                </div>
            </div>

            <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
                <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4">Путь перенаправлений:</h3>
                <div id="redirectChain" class="space-y-3 relative">
                    </div>
            </div>

        </div>
    </div>

    <script>
        async function unshorten() {
            const urlInput = document.getElementById('urlInput');
            const btn = document.getElementById('btn');
            const loader = document.getElementById('loader');
            const resultDiv = document.getElementById('result');
            
            if (!urlInput.value) return;

            // Сброс состояния
            btn.disabled = true;
            loader.classList.remove('hidden');
            resultDiv.classList.add('hidden');
            document.getElementById('redirectChain').innerHTML = '';

            try {
                const response = await fetch('/api/unshorten', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url: urlInput.value })
                });

                const data = await response.json();

                if (data.status === 'success') {
                    // Заполняем данные
                    document.getElementById('finalUrl').innerText = data.final_url;
                    document.getElementById('finalUrl').href = data.final_url;
                    document.getElementById('siteTitle').innerText = data.metadata.title;
                    document.getElementById('siteDesc').innerText = data.metadata.description;
                    document.getElementById('siteIcon').src = data.metadata.favicon;

                    // Строим цепочку редиректов
                    data.chain.forEach((link, index) => {
                        const isLast = index === data.chain.length - 1;
                        const item = document.createElement('div');
                        item.className = "flex items-center gap-3";
                        item.innerHTML = `
                            <div class="flex flex-col items-center">
                                <div class="w-3 h-3 rounded-full ${isLast ? 'bg-green-500' : 'bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.5)]'}"></div>
                                ${!isLast ? '<div class="w-0.5 h-6 bg-slate-700"></div>' : ''}
                            </div>
                            <span class="text-sm truncate ${isLast ? 'text-green-400 font-bold' : 'text-slate-400'}">${link}</span>
                        `;
                        document.getElementById('redirectChain').appendChild(item);
                    });

                    resultDiv.classList.remove('hidden');
                } else {
                    alert('Ошибка: ' + (data.message || 'Не удалось расшифровать ссылку'));
                }
            } catch (error) {
                alert('Произошла ошибка при запросе к серверу');
                console.error(error);
            } finally {
                btn.disabled = false;
                loader.classList.add('hidden');
            }
        }
    </script>
</body>
</html>
